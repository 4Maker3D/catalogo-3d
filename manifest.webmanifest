{
  "name": "4Maker 3D Admin",
  "short_name": "4Maker Admin",
  "description": "Painel administrativo da 4Maker 3D",
  "id": "./login.html",
  "start_url": "./login.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#08090d",
