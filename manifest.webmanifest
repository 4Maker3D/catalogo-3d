      "name": "Abrir painel",
      "short_name": "Painel",
      "url": "./painel.html#dashboard",
      "icons": [
        {
          "src": "logo.png",
          "sizes": "640x640",
          "type": "image/png"
        }
      ]
    }
  ]
}
